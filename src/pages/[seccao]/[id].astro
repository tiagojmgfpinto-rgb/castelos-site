---
import Base from "../../layouts/Base.astro";
import Cabecalho from "../../components/Cabecalho.astro";
import { resumo, todosMonumentos, type Monumento } from "../../lib/monumentos";
import { FichaConteudo } from "../../components/ui/FichaConteudo";
import { REGIOES, TIPOLOGIAS } from "../../lib/tipologias";
import { caminhoFicha, seccaoDe } from "../../lib/rotas";
import MaquetaPagina from "../../components/maqueta/MaquetaPagina";

export async function getStaticPaths() {
  return (await todosMonumentos()).map((m) => ({ params: { seccao: seccaoDe(m.data.nome), id: m.id }, props: { m } }));
}
const { m } = Astro.props as { m: Monumento };
const d = m.data;
const r = resumo(m);
const base = import.meta.env.BASE_URL;
const maqueta = d.maquetas.find((x) => x.tipo === "estado-atual" && (x.validada || x.provisoria));
const vizinhos = (await todosMonumentos()).filter((x) => x.data.regiao === d.regiao && x.id !== m.id).slice(0, 10);
---
<Base titulo={d.nome} descricao={d.resumo ?? `${d.nome}, ${d.localidade}. ${TIPOLOGIAS[d.tipologia].nome} no atlas 3D de Portugal.`} classe="pagina-texto">
  <Cabecalho />
  <main class="texto ficha-pagina">
    <nav class="migalhas" aria-label="Localização">
      <a href={`${base}castelos/`}>Castelos</a> › <a href={`${base}castelos/#${d.regiao}`}>{REGIOES[d.regiao]}</a> › {d.distrito}
    </nav>
    <h1>{d.nome}</h1>
    <p class="entrada">{d.localidade}, {d.distrito}, {REGIOES[d.regiao]} · {d.subtitulo ?? `${TIPOLOGIAS[d.tipologia].nome}${d.seculoOrigem ? ` do ${d.seculoOrigem}` : ""}`}</p>
    <p class="ficha-pagina-acoes">
      {d.estado && <span class="ficha-pagina-estado">{d.estado}</span>}
      <a class="botao-texto" href={`${base}#${m.id}`}>Ver no mapa 3D</a>
    </p>

    {maqueta && (
      <figure class="ficha-maqueta maqueta-pagina">
        <MaquetaPagina client:visible id={m.id} ficheiro={maqueta.ficheiro} capa={maqueta.capa} provisoria={maqueta.provisoria} />
      </figure>
    )}

    <div class="ficha-pagina-corpo">
      <FichaConteudo m={r} nivel={2} />
    </div>

    {vizinhos.length > 0 && (
      <>
        <h2>Mais castelos em {REGIOES[d.regiao]}</h2>
        <ul class="lista-monumentos curta">{vizinhos.map((x) => <li><a href={`${base}${caminhoFicha({ id: x.id, nome: x.data.nome })}`}>{x.data.nome}</a></li>)}</ul>
      </>
    )}
  </main>
</Base>
