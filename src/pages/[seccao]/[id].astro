---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Cabecalho from "../../components/Cabecalho.astro";
import { todosMonumentos, type Monumento } from "../../lib/monumentos";
import { REGIOES, TIPOLOGIAS } from "../../lib/tipologias";
import { caminhoFicha, seccaoDe } from "../../lib/rotas";

export async function getStaticPaths() {
  return (await todosMonumentos()).map((m) => ({ params: { seccao: seccaoDe(m.data.nome), id: m.id }, props: { m } }));
}
const { m } = Astro.props as { m: Monumento };
const d = m.data;
const { Content } = await render(m);
const base = import.meta.env.BASE_URL;
const vizinhos = (await todosMonumentos()).filter((x) => x.data.regiao === d.regiao && x.id !== m.id).slice(0, 10);
---
<Base titulo={d.nome} descricao={`${d.nome}, ${d.localidade}. ${TIPOLOGIAS[d.tipologia].nome} no atlas 3D de Portugal.`} classe="pagina-texto">
  <Cabecalho />
  <main class="texto ficha-pagina">
    <nav class="migalhas" aria-label="Localização">
      <a href={`${base}castelos/`}>Castelos</a> › <a href={`${base}castelos/#${d.regiao}`}>{REGIOES[d.regiao]}</a> › {d.distrito}
    </nav>
    <h1>{d.nome}</h1>
    <p class="entrada">{d.localidade}, {d.concelho} · {TIPOLOGIAS[d.tipologia].nome}{d.seculoOrigem ? ` do ${d.seculoOrigem}` : ""}</p>
    <p><a class="botao" href={`${base}#${m.id}`}>Ver no mapa 3D</a></p>

    {d.estadoFicha === "em-preparacao" && (
      <p class="nota">A ficha histórica deste monumento está em preparação. Só será publicada com fontes documentadas.</p>
    )}
    {d.notas.map((n) => <p class="nota aviso">{n}</p>)}

    <Content />

    <h2>Onde está</h2>
    <dl class="dados">
      <dt>Coordenadas</dt>
      <dd>{d.coordenadas.lat.toFixed(5)}, {d.coordenadas.lon.toFixed(5)} {!d.coordenadas.verificadas && <em>(por verificar)</em>}</dd>
      <dt>Concelho</dt><dd>{d.concelho}</dd>
      <dt>Distrito</dt><dd>{d.distrito}</dd>
    </dl>

    {d.fontes.length > 0 && (
      <>
        <h2>Fontes</h2>
        <ul>{d.fontes.map((f) => <li>{f.url ? <a href={f.url}>{f.titulo}</a> : f.titulo}</li>)}</ul>
      </>
    )}

    {vizinhos.length > 0 && (
      <>
        <h2>Mais em {REGIOES[d.regiao]}</h2>
        <ul class="lista-monumentos curta">{vizinhos.map((x) => <li><a href={`${base}${caminhoFicha({ id: x.id, nome: x.data.nome })}`}>{x.data.nome}</a></li>)}</ul>
      </>
    )}
  </main>
</Base>
