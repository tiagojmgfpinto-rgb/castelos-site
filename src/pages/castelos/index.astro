---
import Base from "../../layouts/Base.astro";
import Cabecalho from "../../components/Cabecalho.astro";
import { todosMonumentos, type Monumento } from "../../lib/monumentos";
import { REGIOES, TIPOLOGIAS, type Regiao, type Tipologia } from "../../lib/tipologias";
import { caminhoFicha } from "../../lib/rotas";
import { comVersao } from "../../lib/versao";
import { normalizar } from "../../lib/catalogo";

const lista = await todosMonumentos();
const regioes = (Object.keys(REGIOES) as Regiao[]).filter((r) => lista.some((m) => m.data.regiao === r));
const tipologias = (Object.keys(TIPOLOGIAS) as Tipologia[]).filter((t) => lista.some((m) => m.data.tipologia === t));
const base = import.meta.env.BASE_URL;

// O que cada cartão mostra e as marcas que os filtros leem (as mesmas regras do atlas: store.ts)
const cartao = (m: Monumento) => {
  const d = m.data;
  const maqueta = d.maquetas.find((x) => x.tipo === "estado-atual" && (x.validada || x.provisoria));
  const visita = !!d.visita && Object.values(d.visita).some(Boolean);
  const capa = maqueta?.capa ?? d.imagens[0]?.ficheiro;
  return {
    id: m.id,
    nome: d.nome,
    href: `${base}${caminhoFicha({ id: m.id, nome: d.nome })}`,
    lugar: [d.localidade, d.distrito].filter((x, i, a) => x && a.indexOf(x) === i).join(", "),
    tipo: `${TIPOLOGIAS[d.tipologia].nome}${d.seculoOrigem ? `, ${d.seculoOrigem}` : ""}`,
    capa: capa ? `${base}${comVersao(capa)}` : undefined,
    capaMaqueta: !!maqueta?.capa,
    forma: TIPOLOGIAS[d.tipologia].forma,
    maqueta: !!maqueta,
    provisoria: !!maqueta?.provisoria,
    visita,
    ficha: d.estadoFicha === "publicada",
    texto: normalizar([d.nome, ...d.outrasDesignacoes, d.localidade, d.concelho, d.distrito].join(" ")),
    regiao: d.regiao,
    tipologia: d.tipologia,
  };
};
const nMaqueta = lista.filter((m) => cartao(m).maqueta).length;
---
<Base titulo="Catálogo dos castelos e fortalezas" descricao={`Catálogo das ${lista.length} fortificações históricas de Portugal no atlas 3D, com pesquisa e filtros.`} classe="pagina-texto">
  <Cabecalho />
  <main class="texto catalogo" data-catalogo>
    <h1>Castelos e fortalezas</h1>
    <p class="entrada">
      {lista.length} fortificações no atlas, {nMaqueta} delas já com maqueta 3D. As fichas históricas e as maquetas são
      publicadas à medida que ficam documentadas.
    </p>

    <form class="catalogo-filtros" role="search" aria-label="Pesquisar e filtrar o catálogo" hidden>
      <label class="catalogo-pesquisa">
        <span>Pesquisar</span>
        <input type="search" name="q" placeholder="Nome, localidade ou distrito" autocomplete="off" />
      </label>
      <label>
        <span>Região</span>
        <select name="regiao">
          <option value="">Todas</option>
          {regioes.map((r) => <option value={r}>{REGIOES[r]}</option>)}
        </select>
      </label>
      <label>
        <span>Tipologia</span>
        <select name="tipo">
          <option value="">Todas</option>
          {tipologias.map((t) => <option value={t}>{TIPOLOGIAS[t].plural}</option>)}
        </select>
      </label>
      <fieldset class="catalogo-marcas">
        <legend class="sr-only">Mostrar só</legend>
        <label><input type="checkbox" name="maqueta" value="1" /> Com maqueta 3D</label>
        <label><input type="checkbox" name="ficha" value="1" /> Com ficha publicada</label>
        <label><input type="checkbox" name="visita" value="1" /> Com informação de visita</label>
      </fieldset>
      <p class="catalogo-resumo">
        <span class="catalogo-conta" aria-live="polite">{lista.length} fortificações</span>
        <button type="reset">Limpar filtros</button>
      </p>
    </form>

    <nav class="ancoras" aria-label="Regiões">
      {regioes.map((r) => <a href={`#${r}`}>{REGIOES[r]}</a>)}
    </nav>

    <p class="catalogo-vazio" hidden>Nenhuma fortificação corresponde à pesquisa e aos filtros escolhidos.</p>

    {regioes.map((r) => {
      const doGrupo = lista.filter((m) => m.data.regiao === r).map(cartao);
      return (
        <section id={r} data-seccao={r}>
          <h2>{REGIOES[r]} <span class="contagem" data-total={doGrupo.length}>{doGrupo.length}</span></h2>
          <ul class="catalogo-grelha">
            {doGrupo.map((c) => (
              <li
                class="catalogo-cartao"
                data-cartao
                data-texto={c.texto}
                data-regiao={c.regiao}
                data-tipologia={c.tipologia}
                data-maqueta={c.maqueta ? "1" : "0"}
                data-visita={c.visita ? "1" : "0"}
                data-ficha={c.ficha ? "1" : "0"}
              >
                <a href={c.href}>
                  <span class={`catalogo-imagem${c.capa ? "" : " catalogo-imagem--vazia"}`} data-forma={c.forma}>
                    {c.capa && <img src={c.capa} alt="" loading="lazy" decoding="async" />}
                  </span>
                  <span class="catalogo-texto">
                    <strong>{c.nome}</strong>
                    <span>{c.lugar}</span>
                    <span class="catalogo-tipo">{c.tipo}</span>
                  </span>
                  <span class="catalogo-etiquetas">
                    {c.maqueta && <span class="catalogo-etiqueta catalogo-etiqueta--maqueta">Maqueta 3D{c.provisoria ? " provisória" : ""}</span>}
                    {c.ficha ? <span class="catalogo-etiqueta">Ficha publicada</span> : <span class="catalogo-etiqueta catalogo-etiqueta--prep">Ficha em preparação</span>}
                    {c.visita && <span class="catalogo-etiqueta">Visita</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      );
    })}
  </main>
</Base>

<script>
  import { instalarCatalogo } from "../../lib/catalogo";
  const raiz = document.querySelector<HTMLElement>("[data-catalogo]");
  if (raiz) instalarCatalogo(raiz);
</script>
